---
/**
 * Portada: campo de puntos sobre una onda que avanza (WebGL), con el título encima.
 * Sustituye al Hero de Starlight solo en las páginas con `hero` en el frontmatter.
 */
import { LinkButton } from '@astrojs/starlight/components';
import pkg from '../../package.json';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="dpe-hero" data-hero>
	<canvas class="dpe-hero__lienzo" aria-hidden="true"></canvas>
	<div class="dpe-hero__velo" aria-hidden="true"></div>
	<div class="dpe-hero__texto">
		<p class="dpe-hero__marca">D.P. Energy <span>Versión {pkg.version}</span></p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="dpe-hero__bajada" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="dpe-hero__acciones">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</section>

<script>
	const VERT = `attribute vec2 a_pos;void main(){gl_Position=vec4(a_pos,0.0,1.0);}`;

	// Onda de dos armónicos (la segunda corre en sentido contrario) dibujada con puntos redondos
	// cuyo tamaño y brillo llevan la intensidad. El puntero empuja una campana hacia su altura.
	const FRAG = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 uRes;
uniform float uTime, uDpr, uCell, uDot, uHover;
uniform vec2 uPtr;
uniform float uA, uB, uC, uD;
uniform vec3 uBg, uBase, uAccent, uHigh;
void main(){
  float cs = max(uCell, 2.0);
  vec2 ci = floor(gl_FragCoord.xy / cs);
  vec2 cc = (ci + 0.5) * cs;
  float x = cc.x / uDpr;
  float y = (uRes.y - cc.y) / uDpr;
  float w = uRes.x / uDpr;
  float h = uRes.y / uDpr;
  float t = uTime;
  float i = 0.0;
  float k = 6.2831853 / max(w * uC, 1.0);
  float y0 = h * uA + h * uB * (sin(x * k - t * 1.2) + 0.35 * sin(x * k * 2.3 + t * 0.9)) / 1.35;
  float gx = (x - uPtr.x) / (w * 0.12);
  float curveY = y0 + (uPtr.y - h * 0.5) * exp(-gx * gx) * 0.8 * uHover;
  float dist = abs(y - curveY);
  float normX = (x - w * 0.5) / (w * 0.75);
  float th = (70.0 + 30.0 * sin(x * k * 0.5 + t * 0.7)) * uD;
  if (dist < th) {
    i = 1.0 - dist / th;
    float waveX = sin(x * 0.015 + t);
    float waveY = cos(y * 0.02 + t);
    i = i * 0.7 + waveX * waveY * 0.3 * i;
    i *= max(0.0, 1.0 - pow(abs(normX), 2.5));
  }
  vec3 col = uBg;
  if (i > 0.02) {
    float side = uDot * i * uDpr;
    vec2 d = abs(gl_FragCoord.xy - cc);
    float cov = 1.0 - smoothstep(side * 0.5 - 1.0, side * 0.5 + 1.0, length(d));
    vec3 ink = mix(uBase, uAccent, clamp(pow(i, 1.1), 0.0, 1.0));
    ink = mix(ink, uHigh, smoothstep(0.72, 1.0, i));
    col = mix(uBg, ink, cov * clamp(i * 1.6, 0.0, 1.0));
  }
  gl_FragColor = vec4(col, 1.0);
}`;

	const OPC = {
		bg: [3, 6, 4],
		base: [14, 59, 31],
		accent: [61, 255, 138],
		high: [255, 255, 255],
		density: 150,
		dotSize: 1,
		speed: 1,
		hover: 1,
		level: 0.64,
		amplitude: 0.16,
		wavelength: 0.6,
		thickness: 1,
	};
	const rgb = (c: number[]) => c.map((v) => v / 255) as [number, number, number];

	function iniciar(root: HTMLElement) {
		const canvas = root.querySelector('canvas')!;
		const gl = canvas.getContext('webgl', { alpha: false, antialias: false, depth: false });
		if (!gl) {
			root.dataset.sinWebgl = '';
			return;
		}
		const compile = (type: number, src: string) => {
			const sh = gl.createShader(type)!;
			gl.shaderSource(sh, src);
			gl.compileShader(sh);
			return gl.getShaderParameter(sh, gl.COMPILE_STATUS) ? sh : null;
		};
		const vs = compile(gl.VERTEX_SHADER, VERT);
		const fs = compile(gl.FRAGMENT_SHADER, FRAG);
		const prog = gl.createProgram();
		if (!vs || !fs || !prog) {
			root.dataset.sinWebgl = '';
			return;
		}
		gl.attachShader(prog, vs);
		gl.attachShader(prog, fs);
		gl.linkProgram(prog);
		if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
			root.dataset.sinWebgl = '';
			return;
		}
		gl.useProgram(prog);
		gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const aPos = gl.getAttribLocation(prog, 'a_pos');
		gl.enableVertexAttribArray(aPos);
		gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
		const loc: Record<string, WebGLUniformLocation | null> = {};
		const u = (n: string) => (n in loc ? loc[n] : (loc[n] = gl.getUniformLocation(prog, n)));

		gl.uniform3f(u('uBg'), ...rgb(OPC.bg));
		gl.uniform3f(u('uBase'), ...rgb(OPC.base));
		gl.uniform3f(u('uAccent'), ...rgb(OPC.accent));
		gl.uniform3f(u('uHigh'), ...rgb(OPC.high));
		gl.uniform1f(u('uA'), OPC.level);
		gl.uniform1f(u('uB'), OPC.amplitude);
		gl.uniform1f(u('uC'), OPC.wavelength);
		gl.uniform1f(u('uD'), OPC.thickness);

		const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const ptr = { tx: 0.5, ty: 0.5, x: 0.5, y: 0.5 };
		let clock = 0;
		let last = performance.now();
		let raf = 0;
		let visible = true;

		const frame = (now: number) => {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			if (!quieto) clock = (clock + dt * 0.9 * OPC.speed) % 6283;
			const k = 1 - Math.exp(-dt * 6);
			ptr.x += (ptr.tx - ptr.x) * k;
			ptr.y += (ptr.ty - ptr.y) * k;

			const dpr = Math.min(devicePixelRatio || 1, 2);
			const bw = Math.max(1, Math.round(canvas.clientWidth * dpr));
			const bh = Math.max(1, Math.round(canvas.clientHeight * dpr));
			if (canvas.width !== bw || canvas.height !== bh) {
				canvas.width = bw;
				canvas.height = bh;
			}
			gl.viewport(0, 0, bw, bh);
			const pitch = Math.min(bw, bh) / dpr / OPC.density;
			gl.uniform2f(u('uRes'), bw, bh);
			gl.uniform1f(u('uTime'), clock);
			gl.uniform1f(u('uDpr'), dpr);
			gl.uniform1f(u('uCell'), Math.max(2, pitch * dpr));
			gl.uniform1f(u('uDot'), pitch * 1.2 * OPC.dotSize);
			gl.uniform1f(u('uHover'), quieto ? 0 : OPC.hover);
			gl.uniform2f(u('uPtr'), ptr.x * (bw / dpr), ptr.y * (bh / dpr));
			gl.drawArrays(gl.TRIANGLES, 0, 3);
			raf = !quieto && visible && !document.hidden ? requestAnimationFrame(frame) : 0;
		};
		const arrancar = () => {
			if (!raf) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			}
		};

		root.addEventListener('pointermove', (e) => {
			const r = root.getBoundingClientRect();
			ptr.tx = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
			ptr.ty = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
		});
		root.addEventListener('pointerleave', () => {
			ptr.tx = 0.5;
			ptr.ty = 0.5;
		});
		new IntersectionObserver(([e]) => {
			visible = e.isIntersecting;
			if (visible) arrancar();
		}).observe(root);
		document.addEventListener('visibilitychange', () => !document.hidden && arrancar());
		new ResizeObserver(() => (quieto ? requestAnimationFrame(frame) : arrancar())).observe(canvas);
		arrancar();
	}

	document.querySelectorAll<HTMLElement>('[data-hero]').forEach(iniciar);
</script>

<style>
	.dpe-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: clamp(26rem, 62vh, 36rem);
		display: flex;
		align-items: flex-start;
		margin-bottom: 2rem;
		border-radius: 1.25rem;
		background: #030604;
		color: #f2f5f7;
	}
	.dpe-hero[data-sin-webgl] {
		background:
			radial-gradient(60% 50% at 50% 70%, rgba(61, 255, 138, 0.22), transparent 70%),
			#030604;
	}
	.dpe-hero__lienzo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		z-index: -2;
	}
	.dpe-hero__velo {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(180deg, rgba(3, 6, 4, 0.92) 0%, rgba(3, 6, 4, 0.55) 42%, rgba(3, 6, 4, 0) 68%);
	}
	.dpe-hero__texto {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: 40rem;
		padding: clamp(2rem, 5vw, 3.5rem);
	}
	.dpe-hero__marca {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #3dff8a;
	}
	.dpe-hero__marca span {
		margin-left: 0.6rem;
		padding-left: 0.6rem;
		border-left: 1px solid rgba(242, 245, 247, 0.25);
		color: rgba(242, 245, 247, 0.6);
		letter-spacing: 0.08em;
	}
	.dpe-hero h1 {
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 3.6rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		color: #ffffff;
	}
	.dpe-hero__bajada {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.55;
		color: rgba(242, 245, 247, 0.72);
	}
	.dpe-hero__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
	.dpe-hero__acciones :global(.sl-link-button) {
		border-radius: 999px;
		font-size: 0.95rem;
		padding: 0.7rem 1.25rem;
	}
	.dpe-hero__acciones :global(.sl-link-button.primary) {
		background: #3dff8a;
		border-color: #3dff8a;
		color: #030604;
	}
	.dpe-hero__acciones :global(.sl-link-button.minimal),
	.dpe-hero__acciones :global(.sl-link-button.secondary) {
		color: #f2f5f7;
		border: 1px solid rgba(242, 245, 247, 0.28);
	}
	.dpe-hero__acciones :global(.sl-link-button:focus-visible) {
		outline: 2px solid #3dff8a;
		outline-offset: 3px;
	}
</style>
