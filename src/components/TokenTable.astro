---
/** Tabla de tokens desde la fuente única. Con `filter`, añade un buscador. */
import tokens from '../tokens/tokens.flat.json';

interface Props {
	/** Grupos a mostrar (color, chrome, marca, tipografia, espaciado, radio, sombra, velo, movimiento, grafica, base). */
	groups?: string[];
	/** Nombres concretos (sin --). Tiene prioridad sobre groups. */
	names?: string[];
	filter?: boolean;
}

const { groups, names, filter = false } = Astro.props;
const rows = tokens.filter((t) =>
	names ? names.includes(t.name.slice(2)) : groups ? groups.includes(t.group) : true,
);
const isColor = (t: (typeof tokens)[number]) => t.type === 'color';
const id = `tt-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="dpe-tokens not-content" id={id}>
	{
		filter && (
			<label class="dpe-tokens__filtro">
				<span class="sr-only">Filtrar tokens</span>
				<input type="search" placeholder={`Filtrar ${rows.length} tokens por nombre, valor o uso`} data-filtro />
			</label>
		)
	}
	<div class="dpe-tokens__caja">
		<table>
			<thead>
				<tr>
					<th scope="col">Token</th>
					<th scope="col">Claro</th>
					<th scope="col">Oscuro</th>
					<th scope="col">Uso</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((t) => (
						<tr data-busca={`${t.name} ${t.light} ${t.dark ?? ''} ${t.description}`.toLowerCase()}>
							<th scope="row">
								<span class="dpe-tokens__nombre">
									{isColor(t) && <span class="dpe-tokens__muestra" style={`background:var(${t.name})`} />}
									<code>{t.name}</code>
									<button type="button" class="dpe-tokens__copiar" data-copia={`var(${t.name})`} aria-label={`Copiar var(${t.name})`}>
										<svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#i-content_copy" /></svg>
									</button>
								</span>
							</th>
							<td><code>{t.light}</code></td>
							<td>{t.dark ? <code>{t.dark}</code> : <span class="dpe-tokens__igual">igual</span>}</td>
							<td>{t.description}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<p class="dpe-tokens__vacio" hidden>Ningún token coincide.</p>
	<p class="sr-only" aria-live="polite" data-aviso></p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.dpe-tokens').forEach((box) => {
		const input = box.querySelector<HTMLInputElement>('[data-filtro]');
		const rows = [...box.querySelectorAll<HTMLElement>('tbody tr')];
		const empty = box.querySelector<HTMLElement>('.dpe-tokens__vacio')!;
		input?.addEventListener('input', () => {
			const q = input.value.trim().toLowerCase();
			let n = 0;
			rows.forEach((r) => {
				const hit = !q || r.dataset.busca!.includes(q);
				r.hidden = !hit;
				if (hit) n++;
			});
			empty.hidden = n > 0;
		});
		box.addEventListener('click', async (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copia]');
			if (!b) return;
			try {
				await navigator.clipboard.writeText(b.dataset.copia!);
			} catch {}
			b.dataset.hecho = 'true';
			box.querySelector('[data-aviso]')!.textContent = `${b.dataset.copia} copiado`;
			setTimeout(() => delete b.dataset.hecho, 1500);
		});
	});
</script>

<style>
	.dpe-tokens {
		margin: 1.5rem 0;
	}
	.dpe-tokens__filtro input {
		width: 100%;
		max-width: 28rem;
		min-height: 2.5rem;
		margin-bottom: 0.75rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: var(--r-ctrl);
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--fs-dense);
	}
	.dpe-tokens__filtro input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.dpe-tokens__caja {
		overflow-x: auto;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--r-card);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--fs-dense);
	}
	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: 0.55rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-gray-2);
	}
	thead th {
		font-size: var(--fs-meta);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
		background: var(--sl-color-gray-6);
	}
	tbody th {
		font-weight: 400;
		white-space: nowrap;
		width: 1%;
	}
	tbody td:nth-child(2),
	tbody td:nth-child(3) {
		width: 1%;
		max-width: 13rem;
	}
	tbody td:nth-child(2) code,
	tbody td:nth-child(3) code {
		white-space: normal;
		overflow-wrap: anywhere;
	}
	tbody td:nth-child(4) {
		min-width: 14rem;
	}
	tbody tr:last-child > * {
		border-bottom: 0;
	}
	code {
		font-size: 0.8em;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.dpe-tokens__nombre {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.dpe-tokens__muestra {
		width: 1rem;
		height: 1rem;
		border-radius: 4px;
		box-shadow: inset 0 0 0 1px rgba(127, 127, 127, 0.35);
		flex-shrink: 0;
	}
	.dpe-tokens__copiar {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border: 0;
		border-radius: var(--r-ctrl);
		background: none;
		color: var(--sl-color-gray-3);
		fill: currentColor;
		cursor: pointer;
	}
	.dpe-tokens__copiar:hover,
	.dpe-tokens__copiar[data-hecho] {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-accent);
	}
	.dpe-tokens__igual {
		color: var(--sl-color-gray-4);
		font-size: var(--fs-meta);
	}
	.dpe-tokens__vacio {
		padding: 1rem;
		color: var(--sl-color-gray-3);
	}
</style>
