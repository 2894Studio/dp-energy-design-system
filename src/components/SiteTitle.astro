---
/** Marca del sitio: wordmark tipográfico, sin isotipo. */
---

<a href="/" class="dpe-site-title">
	<span class="dpe-site-mark">D.P. Energy</span>
	<span class="dpe-site-tag">Sistema de diseño</span>
</a>

<style>
	.dpe-site-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.dpe-site-mark {
		font-family: var(--font-brand);
		font-size: 1.05rem;
		font-weight: 650;
		letter-spacing: -0.02em;
	}
	.dpe-site-tag {
		font-size: var(--fs-dense);
		color: var(--sl-color-gray-3);
		border-inline-start: 1px solid var(--sl-color-hairline);
		padding-inline-start: 0.75rem;
	}
	@media (max-width: 50rem) {
		.dpe-site-tag {
			display: none;
		}
	}
</style>
